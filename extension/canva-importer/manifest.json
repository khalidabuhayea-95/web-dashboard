{
  "manifest_version": 3,
  "name": "Dashboard Canva Importer",
  "version": "1.0.0",
  "description": "Import Canva designs from the active tab into the dashboard templates.",
  "permissions": [
    "activeTab",
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://www.canva.com/*",
    "https://*.canva.com/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' http://* https://*"
  }
}

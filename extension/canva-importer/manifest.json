{
  "manifest_version": 3,
  "name": "Dashboard Canva Importer",
  "version": "1.10.2",
  "version_name": "1.10.2-bgvideo-poster-flips",
  "description": "Import Canva designs from the active tab into the dashboard templates.",
  "permissions": [
    "activeTab",
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://www.canva.com/*",
    "https://*.canva.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' http://* https://*"
  }
}

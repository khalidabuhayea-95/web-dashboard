    ]
   }
  },
  "params": {
   "amplitude": {
    "default": 1,
    "min": 0,
    "max": 3
   }
  },
  "id": "breathe"
 },
 "sway": {
  "phase": "loop",
  "cat": "loop",
  "targets": [
   "sprig",
   "lantern",
   "flower"
  ],
  "loop": {
   "period": 5000,
   "wave": "sine",
   "props": {
    "rotate": [
     0,
     3
    ]
   }
  },
  "params": {
   "amplitude": {
    "default": 1,
    "min": 0,
    "max": 3
   }
  },
  "note": "Pivot at top for lanterns, bottom for sprigs.",
  "id": "sway"
 },
 "twinkle": {
  "phase": "loop",
  "cat": "loop",
  "targets": [
   "sparkle",
   "star"
  ],

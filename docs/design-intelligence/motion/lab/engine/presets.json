{
 "fade-in": {
  "phase": "entrance",
  "cat": "fade",
  "targets": [
   "any"
  ],
  "duration": 600,
  "ease": "cubicOut",
  "from": {
   "opacity": 0
  },
  "to": {
   "opacity": 1
  },
  "id": "fade-in"
 },
 "fade-up": {
  "phase": "entrance",
  "cat": "slide",
  "targets": [
   "any"
  ],
  "duration": 700,
  "ease": "expoOut",
  "params": {
   "distance": {
    "default": 40,
    "min": 0,
    "max": 200
   }
  },
  "from": {
   "opacity": 0,
   "y": "$distance"
  },
  "to": {
   "opacity": 1,
   "y": 0
  },
  "id": "fade-up"
 },
 "fade-down": {
  "phase": "entrance",
  "cat": "slide",
  "targets": [
   "any"
  ],
  "duration": 700,
  "ease": "expoOut",
  "params": {
   "distance": {
    "default": 40,
    "min": 0,
    "max": 200
   }
  },
  "from": {
   "opacity": 0,
   "y": "-$distance"
  },
  "to": {
   "opacity": 1,
   "y": 0
  },
  "id": "fade-down"
 },
 "slide-in-start": {
  "phase": "entrance",
  "cat": "slide",
  "targets": [
   "any"
  ],
  "duration": 800,
  "ease": "quartOut",
  "params": {
   "distance": {
    "default": 120,
    "min": 0,
    "max": 1080
   }
  },
  "from": {
   "opacity": 0,
   "x": "$distance"
  },
  "to": {
   "opacity": 1,
   "x": 0
  },
  "note": "RTL start = from the right (+x). Mirror for LTR.",
  "id": "slide-in-start"
 },
 "slide-in-end": {
  "phase": "entrance",
  "cat": "slide",
  "targets": [
   "any"
  ],
  "duration": 800,
  "ease": "quartOut",
  "params": {
   "distance": {
    "default": 120,
    "min": 0,
    "max": 1080
   }
  },
  "from": {
   "opacity": 0,
   "x": "-$distance"
  },
  "to": {
   "opacity": 1,
   "x": 0
  },
  "id": "slide-in-end"
 },
 "drift-in": {
  "phase": "entrance",
  "cat": "slide",
  "targets": [
   "text",
   "image"
  ],
  "duration": 1400,
  "ease": "silk",
  "params": {
   "distance": {
    "default": 24,
    "min": 0,
    "max": 80
   }
  },
  "from": {
   "opacity": 0,
   "x": "$distance"
  },
  "to": {
   "opacity": 1,
   "x": 0
  },
  "note": "Long, low-distance: luxury.",
  "id": "drift-in"
 },
 "scale-in": {
  "phase": "entrance",
  "cat": "scale",
  "targets": [
   "any"
  ],
  "duration": 600,
  "ease": "cubicOut",
  "params": {
   "fromScale": {
    "default": 0.85,
    "min": 0,
    "max": 1
   }
  },
  "from": {
   "opacity": 0,
   "scale": "$fromScale"
  },
  "to": {
   "opacity": 1,
   "scale": 1
  },
  "id": "scale-in"
 },
 "settle-in": {
  "phase": "entrance",
  "cat": "scale",
  "targets": [
   "text",
   "image"
  ],
  "duration": 1600,
  "ease": "silk",
  "from": {
   "opacity": 0,
   "scale": 1.06,
   "blur": 6
  },
  "to": {
   "opacity": 1,
   "scale": 1,
   "blur": 0
  },
  "note": "Large -> 1 with blur clearing. Elegant hero.",
  "id": "settle-in"
 },
 "zoom-in": {
  "phase": "entrance",
  "cat": "scale",
  "targets": [
   "image",
   "shape"
  ],
  "duration": 900,
  "ease": "expoOut",
  "from": {
   "opacity": 0,
   "scale": 1.6
  },
  "to": {
   "opacity": 1,
   "scale": 1
  },
  "id": "zoom-in"
 },
 "pop": {
  "phase": "entrance",
  "cat": "scale",
  "targets": [
   "icon",
   "badge",
   "shape",
   "text"
  ],
  "duration": 550,
  "ease": "backOut",
  "from": {
   "opacity": 0,
   "scale": 0.4
  },
  "to": {
   "opacity": 1,
   "scale": 1
  },
  "id": "pop"
 },
 "pop-spring": {
  "phase": "entrance",
  "cat": "scale",
  "targets": [
   "icon",
   "badge"
  ],
  "duration": 900,
  "ease": "springBouncy",
  "from": {
   "opacity": 0,
   "scale": 0.3
  },
  "to": {
   "opacity": 1,
   "scale": 1
  },
  "id": "pop-spring"
 },
 "rise": {
  "phase": "entrance",
  "cat": "slide",
  "targets": [
   "any"
  ],
  "duration": 900,
  "ease": "expoOut",
  "params": {
   "distance": {
    "default": 80,
    "min": 0,
    "max": 400
   }
  },
  "from": {
   "opacity": 0,
   "y": "$distance"
  },
  "to": {
   "opacity": 1,
   "y": 0
  },
  "note": "Ali: never on backgrounds.",
  "id": "rise"
 },
 "bounce-in": {
  "phase": "entrance",
  "cat": "bounce",
  "targets": [
   "icon",
   "badge",
   "sticker"
  ],
  "duration": 900,
  "ease": "bounceOut",
  "from": {
   "opacity": 1,
   "y": -300
  },
  "to": {
   "y": 0
  },
  "id": "bounce-in"
 },
 "blur-in": {
  "phase": "entrance",
  "cat": "blur",
  "targets": [
   "text",
   "image"
  ],
  "duration": 900,
  "ease": "cubicOut",
  "params": {
   "radius": {
    "default": 16,
    "min": 0,
    "max": 40
   }
  },
  "from": {
   "opacity": 0,
   "blur": "$radius"
  },
  "to": {
   "opacity": 1,
   "blur": 0
  },
  "id": "blur-in"
 },
 "mask-reveal-up": {
  "phase": "entrance",
  "cat": "mask",
  "targets": [
   "text",
   "image"
  ],
  "duration": 900,
  "ease": "expoOut",
  "params": {
   "distance": {
    "default": 30,
    "min": 0,
    "max": 120
   }
  },
  "from": {
   "clipT": 100,
   "y": "$distance"
  },
  "to": {
   "clipT": 0,
   "y": 0
  },
  "note": "Clip from top edge + slight rise: classic title reveal.",
  "id": "mask-reveal-up"
 },
 "wipe-start": {
  "phase": "entrance",
  "cat": "mask",
  "targets": [
   "any"
  ],
  "duration": 1000,
  "ease": "quartInOut",
  "from": {
   "clipL": 100
  },
  "to": {
   "clipL": 0
  },
  "note": "RTL: reveals right->left (clipL shrinks).",
  "id": "wipe-start"
 },
 "wipe-center": {
  "phase": "entrance",
  "cat": "mask",
  "targets": [
   "line",
   "divider",
   "image"
  ],
  "duration": 900,
  "ease": "expoOut",
  "from": {
   "clipL": 50,
   "clipR": 50
  },
  "to": {
   "clipL": 0,
   "clipR": 0
  },
  "id": "wipe-center"
 },
 "iris-in": {
  "phase": "entrance",
  "cat": "mask",
  "targets": [
   "image",
   "frame"
  ],
  "duration": 1100,
  "ease": "expoOut",
  "from": {
   "clipT": 50,
   "clipB": 50,
   "clipL": 50,
   "clipR": 50,
   "scale": 1.1
  },
  "to": {
   "clipT": 0,
   "clipB": 0,
   "clipL": 0,
   "clipR": 0,
   "scale": 1
  },
  "id": "iris-in"
 },
 "draw-stroke": {
  "phase": "entrance",
  "cat": "draw",
  "targets": [
   "path",
   "ornament",
   "divider"
  ],
  "duration": 1600,
  "ease": "sineInOut",
  "from": {
   "draw": 0
  },
  "to": {
   "draw": 1
  },
  "id": "draw-stroke"
 },
 "flip-in-y": {
  "phase": "entrance",
  "cat": "3d",
  "targets": [
   "card",
   "image"
  ],
  "duration": 1000,
  "ease": "backOutSoft",
  "from": {
   "opacity": 0,
   "rotateY": -90
  },
  "to": {
   "opacity": 1,
   "rotateY": 0
  },
  "id": "flip-in-y"
 },
 "stretch-snap": {
  "phase": "entrance",
  "cat": "stretch",
  "targets": [
   "text"
  ],
  "duration": 700,
  "keyframes": [
   {
    "t": 0,
    "props": {
     "scaleY": 0,
     "opacity": 1
    }
   },
   {
    "t": 0.55,
    "props": {
     "scaleY": 1.35
    },
    "ease": "expoOut"
   },
   {
    "t": 1,
    "props": {
     "scaleY": 1
    },
    "ease": "backOut"
   }
  ],
  "note": "Jitter \"Snappy Text Stretch\" style.",
  "id": "stretch-snap"
 },
 "typewriter": {
  "phase": "entrance",
  "cat": "text",
  "targets": [
   "text"
  ],
  "duration": 1,
  "ease": "linear",
  "from": {
   "opacity": 0
  },
  "to": {
   "opacity": 1
  },
  "unit": "letter",
  "note": "Per-unit instant-on; stagger.each = typing speed. Latin only. Arabic: unit=word.",
  "id": "typewriter"
 },
 "glitch-in": {
  "phase": "entrance",
  "cat": "advanced",
  "targets": [
   "text",
   "image"
  ],
  "duration": 700,
  "keyframes": [
   {
    "t": 0,
    "props": {
     "opacity": 0,
     "rgbSplit": 0,
     "x": 0
    }
   },
   {
    "t": 0.15,
    "props": {
     "opacity": 1,
     "rgbSplit": 14,
     "x": -12
    },
    "ease": "steps(2)"
   },
   {
    "t": 0.3,
    "props": {
     "rgbSplit": -10,
     "x": 10
    },
    "ease": "steps(2)"
   },
   {
    "t": 0.45,
    "props": {
     "rgbSplit": 6,
     "x": -4
    },
    "ease": "steps(2)"
   },
   {
    "t": 0.7,
    "props": {
     "rgbSplit": 0,
     "x": 0
    },
    "ease": "cubicOut"
   },
   {
    "t": 1,
    "props": {
     "rgbSplit": 0,
     "x": 0
    }
   }
  ],
  "id": "glitch-in"
 },
 "count-up": {
  "phase": "entrance",
  "cat": "text",
  "targets": [
   "number"
  ],
  "duration": 1400,
  "ease": "expoOut",
  "from": {
   "value": 0
  },
  "to": {
   "value": 1
  },
  "note": "Renderer maps value 0..1 to the target number.",
  "id": "count-up"
 },
 "pulse-once": {
  "phase": "emphasis",
  "cat": "scale",
  "targets": [
   "badge",
   "cta"
  ],
  "duration": 600,
  "keyframes": [
   {
    "t": 0,
    "props": {
     "scale": 1
    }
   },
   {
    "t": 0.4,
    "props": {
     "scale": 1.12
    },
    "ease": "cubicOut"
   },
   {
    "t": 1,
    "props": {
     "scale": 1
    },
    "ease": "cubicInOut"
   }
  ],
  "id": "pulse-once"
 },
 "wiggle": {
  "phase": "emphasis",
  "cat": "rotate",
  "targets": [
   "icon",
   "cta"
  ],
  "duration": 700,
  "keyframes": [
   {
    "t": 0,
    "props": {
     "rotate": 0
    }
   },
   {
    "t": 0.2,
    "props": {
     "rotate": -8
    }
   },
   {
    "t": 0.4,
    "props": {
     "rotate": 7
    }
   },
   {
    "t": 0.6,
    "props": {
     "rotate": -4
    }
   },
   {
    "t": 0.8,
    "props": {
     "rotate": 2
    }
   },
   {
    "t": 1,
    "props": {
     "rotate": 0
    }
   }
  ],
  "id": "wiggle"
 },
 "shimmer-sweep": {
  "phase": "emphasis",
  "cat": "light",
  "targets": [
   "text",
   "gold"
  ],
  "duration": 1600,
  "ease": "sineInOut",

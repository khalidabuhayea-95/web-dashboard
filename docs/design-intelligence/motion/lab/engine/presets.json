   "period": 1800,
   "wave": "pulse",
   "props": {
    "opacity": [
     1,
     -0.75
    ],
    "scale": [
     1,
     -0.25
    ]
   }
  },
  "params": {
   "amplitude": {
    "default": 1,
    "min": 0,
    "max": 1
   }
  },
  "id": "twinkle"
 },

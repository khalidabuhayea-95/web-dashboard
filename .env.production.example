# Production environment for docker-compose.prod.yml. Copy to .env.production on the server and fill
# in real values. .env.production is gitignored AND dockerignored: it is read by the containers at
# runtime, never baked into the image.
#
# Domains are not configured here: src/lib/surfaces.js defaults to nayroz.com / admin.nayroz.com /
# api.nayroz.com, and docker-compose.prod.yml sets NEXT_PUBLIC_APP_URL and AUTH_TRUST_HOST.

# ---- Database (the compose `postgres` service reads the POSTGRES_* values) ----
POSTGRES_USER=nayroz_user
POSTGRES_PASSWORD=
POSTGRES_DB=nayroz_app
# Must match the three values above; `postgres` is the compose service name.
DATABASE_URL=postgresql://nayroz_user:<POSTGRES_PASSWORD>@postgres:5432/nayroz_app

# ---- Secrets (generate each with: openssl rand -base64 48) ----
AUTH_SECRET=
CANVA_IMPORT_TOKEN_SECRET=
MOBILE_API_KEY_ID=mobile-client-1
MOBILE_API_SIGNING_SECRET=
# report = verify + count only; enforce = reject unsigned app requests (after the app ships signing).
# MOBILE_REQUEST_SIGNING_MODE=report

# ---- First admin account (created on first boot only) ----
SYSTEM_ADMIN_EMAIL=
SYSTEM_ADMIN_PASSWORD=
SYSTEM_ADMIN_NAME=System Admin

# ---- Cloudflare R2 (production buckets, not the *-dev ones) ----
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
R2_PUBLIC_BUCKET=
R2_PRIVATE_BUCKET=
R2_PUBLIC_BASE_URL=
EDITOR_MEDIA_BUCKET=
TEMPLATE_THUMBNAIL_BUCKET=
OBJECT_REMOVE_INPUT_BUCKET=
OBJECT_REMOVE_OUTPUT_BUCKET=

# ---- AI providers ----
REPLICATE_API_TOKEN=
OBJECT_REMOVE_REPLICATE_MODEL=
OBJECT_REMOVE_REPLICATE_VERSION=
# Tashkeel runs in-process (ichkil ONNX, baked into the image). Optional:
# ICHKIL_THREADS=2             # ONNX Runtime threads for tashkeel
# Self-hosted AI worker (ai-worker/, RunPod Serverless): only for the selfhost/* image models
# (object removal, upscale) if switched on. See docs/deploy-hetzner.md ("AI worker").
SELFHOST_AI_URL=
SELFHOST_AI_TOKEN=

# ---- Subscriptions ----
APPLE_IAP_ISSUER_ID=
APPLE_IAP_KEY_ID=
APPLE_IAP_PRIVATE_KEY=
APPLE_BUNDLE_ID=com.nayroz.ios
APPLE_APP_APPLE_ID=
APPLE_IAP_ENVIRONMENT=production
PLAY_PACKAGE_NAME=com.nayroz.android
PLAY_SERVICE_ACCOUNT_JSON=
# Shared token for the Play RTDN push subscription:
#   https://api.nayroz.com/v1/webhooks/playstore?token=<PLAY_RTDN_AUTH>
PLAY_RTDN_AUTH=
# Never "1" in production: sandbox purchases must not grant real entitlements.
ALLOW_SANDBOX_ENTITLEMENTS=0

# ---- Build time ----
# IOS_TEAM_ID is baked into /.well-known/apple-app-site-association when the image is BUILT
# (the route is force-static), so it is passed as a build arg, not read from this file:
#   IOS_TEAM_ID=ABCDE12345 docker compose -f docker-compose.yml -f docker-compose.prod.yml build

# ---- Backups (deploy/backup-db.sh, nightly) ----
# A PRIVATE R2 bucket for off-site database dumps (db/<file>), uploaded with the R2_* credentials
# above. Give it a lifecycle rule (e.g. delete after 30 days). Empty = local dumps only.
BACKUP_R2_BUCKET=

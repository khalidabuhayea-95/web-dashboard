DATABASE_URL=postgresql://nayroz_user:strongpassword@127.0.0.1:5433/nayroz_app
AUTH_SECRET=replace-with-strong-dashboard-auth-secret
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Website / dashboard / api split by hostname (src/lib/surfaces.js, docs/architecture.md).
# Defaults are the production domains, so these are only needed for another environment
# (e.g. staging). Comma-separated hosts; origins are used for cross-surface redirects.
# WEBSITE_HOSTS=nayroz.com,www.nayroz.com
# DASHBOARD_HOSTS=admin.nayroz.com
# API_HOSTS=api.nayroz.com
# WEBSITE_ORIGIN=https://nayroz.com
# DASHBOARD_ORIGIN=https://admin.nayroz.com
# API_ORIGIN=https://api.nayroz.com
# Serve only some surfaces from this instance (scale the API on its own). Unset = all.
# NAYROZ_SURFACES=api
# Required: NextAuth builds sign-in/callback URLs from the request Host (admin.localhost:3000
# locally, admin.nayroz.com in production). Without it they default to http://localhost:3000,
# which is the website, and dashboard sign-in fails with "Failed to fetch".
AUTH_TRUST_HOST=true

# Initial system-admin account (seeded on first boot only).
# If either is unset, seeding is skipped — no default password is ever used.
# To rotate: change SYSTEM_ADMIN_PASSWORD (applied only on first create) or
# update the password from the dashboard once the account exists.
SYSTEM_ADMIN_EMAIL=
SYSTEM_ADMIN_PASSWORD=
SYSTEM_ADMIN_NAME=System Admin

# Dedicated HMAC secret for Canva extension import tokens.
# Required — must NOT be left blank (the app no longer falls back to DATABASE_URL).
CANVA_IMPORT_TOKEN_SECRET=replace-with-strong-secret

# Cloudflare R2 object storage
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
R2_PUBLIC_BUCKET=nayroz-media-dev
R2_PRIVATE_BUCKET=nayroz-processing-dev
R2_PUBLIC_BASE_URL=
EDITOR_MEDIA_BUCKET=nayroz-media-dev
TEMPLATE_THUMBNAIL_BUCKET=nayroz-media-dev
OBJECT_REMOVE_INPUT_BUCKET=nayroz-processing-dev
OBJECT_REMOVE_OUTPUT_BUCKET=nayroz-media-dev

# Mobile API HMAC auth (optional in local; required in production)
MOBILE_API_KEY_ID=mobile-client-1
MOBILE_API_SIGNING_SECRET=replace-with-strong-secret

# ---- Nayroz Pro subscriptions (src/lib/billing) ----
# Apple App Store Server API key: App Store Connect → Users & Access →
# Integrations → In-App Purchase. Leave blank until the ASC app exists.
APPLE_IAP_ISSUER_ID=
APPLE_IAP_KEY_ID=
# Paste the .p8 content; literal newlines or \n escapes both work.
APPLE_IAP_PRIVATE_KEY=
APPLE_BUNDLE_ID=com.nayroz.ios
# Numeric Apple id of the app — required only when APPLE_IAP_ENVIRONMENT=production.
APPLE_APP_APPLE_ID=
# production | sandbox | xcode. "xcode" accepts StoreKit-test-signed receipts
# (simulator dev lane) and must NEVER be set in production.
APPLE_IAP_ENVIRONMENT=sandbox

# Google Play Developer API service account (JSON key, raw or base64) with
# access to the Play Console app, plus the app's package name.
PLAY_PACKAGE_NAME=com.nayroz.android
PLAY_SERVICE_ACCOUNT_JSON=
# Shared token the Pub/Sub RTDN push subscription appends to the webhook URL:
# https://api.nayroz.com/v1/webhooks/playstore?token=<PLAY_RTDN_AUTH>
PLAY_RTDN_AUTH=

# "1" lets sandbox/xcode purchases flip real user tiers. Dev/staging only.
ALLOW_SANDBOX_ENTITLEMENTS=1

# Public template share links (https://nayroz.com/t/<templateIdOrSlug>)
# Apple Developer > Membership > Team ID. Baked into the appID served by
# /.well-known/apple-app-site-association, so it must be set at BUILD time
# (the route is force-static). iOS Universal Links silently fall back to the
# web page until this is a real team id. See docs/share-links.md.
IOS_TEAM_ID=
# Optional: only for a staging host that serves its own assetlinks.json /
# apple-app-site-association pair. Defaults to https://nayroz.com.
# NEXT_PUBLIC_SHARE_ORIGIN=

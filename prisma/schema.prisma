// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Template {
  id              String             @id @default(uuid()) @db.Uuid
  ownerId         String             @db.Uuid
  name            String
  slug            String             @unique
  status          String             @default("draft")
  version         Int                @default(1)
  canvasSize      Json
  category        String             @default("general")
  subCategory     String             @default("general")
  tags            Json
  thumbnailDataUrl String?
  previewVideoUrl String?
  previewPosterUrl String?
  previewStatus   String?
  previewDurationMs Int?
  previewVersion  Int?
  previewError    String?
  previewUpdatedAt DateTime?
  data            Json
  publishedAt DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  revisions       TemplateRevision[]

  @@index([ownerId])
  @@index([status])
  @@unique([ownerId, name])
}

model TemplateRevision {
  id         String   @id @default(uuid()) @db.Uuid
  templateId String   @db.Uuid
  version    Int
  action     String
  actorId    String   @db.Uuid
  snapshot   Json
  createdAt  DateTime @default(now())
  template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId, createdAt(sort: Desc)])
}

model FontFamily {
  id               String      @id @default(uuid()) @db.Uuid
  family           String
  normalizedFamily String      @unique
  displayName      String?
  source           String      @default("custom")
  sourceId         String?
  status           String      @default("ready")
  categories       Json
  previewText      String?
  previewWeight    Int?
  cssFontFamily    String?
  removable        Boolean     @default(true)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  files            FontFile[]
  aliases          FontAlias[]

  @@index([source])
  @@index([status])
  @@index([updatedAt])
}

model FontFile {
  id            String     @id @default(uuid()) @db.Uuid
  fontId        String     @db.Uuid
  kind          String
  format        String
  mimeType      String
  fileName      String?
  storageBucket String?
  storagePath   String?
  publicUrl     String?
  sizeBytes     Int?
  checksum      String?
  status        String     @default("ready")
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  font          FontFamily @relation(fields: [fontId], references: [id], onDelete: Cascade)

  @@unique([fontId, kind])
  @@index([fontId])
  @@index([kind])
  @@index([status])
}

model FontAlias {
  id              String     @id @default(uuid()) @db.Uuid
  fontId          String     @db.Uuid
  alias           String
  normalizedAlias String     @unique
  createdAt       DateTime   @default(now())
  font            FontFamily @relation(fields: [fontId], references: [id], onDelete: Cascade)

  @@index([fontId])
}

model AppSetting {
  key       String   @id
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

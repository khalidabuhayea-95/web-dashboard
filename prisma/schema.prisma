// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Template {
  id                String                   @id @default(uuid()) @db.Uuid
  ownerId           String                   @db.Uuid
  name              String
  slug              String                   @unique
  status            String                   @default("draft")
  version           Int                      @default(1)
  canvasSize        Json
  pageCount         Int                      @default(1)
  /// Per-page preview images for multi-page designs: { [pageId]: publicUrl }. Page 1 falls back
  /// to thumbnailDataUrl, so this is only populated for pages 2..N.
  pageThumbnails    Json?
  category          String                   @default("general")
  subCategory       String                   @default("general")
  tags              Json
  thumbnailDataUrl  String?
  previewVideoUrl   String?
  previewPosterUrl  String?
  previewStatus     String?
  previewDurationMs Int?
  previewVersion    Int?
  previewError      String?
  previewUpdatedAt  DateTime?
  data              Json
  /// Pro-only template. Included in the catalog for everyone (the app shows a
  /// crown badge and walls at the point of use), like AiTemplate.isPremium.
  isPremium         Boolean                  @default(false)
  publishedAt       DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  revisions         TemplateRevision[]
  favorites         MobileFavoriteTemplate[]

  @@unique([ownerId, name])
  @@index([ownerId])
  @@index([status])
  // Hot-path composites: catalog browse (status+category+subCategory ordered by
  // recency), status-wide recency lists, and the editor "my templates" list.
  @@index([status, category, subCategory, updatedAt(sort: Desc)])
  @@index([status, updatedAt(sort: Desc)])
  @@index([ownerId, updatedAt(sort: Desc)])
}

model TemplateRevision {
  id         String   @id @default(uuid()) @db.Uuid
  templateId String   @db.Uuid
  version    Int
  action     String
  actorId    String   @db.Uuid
  snapshot   Json
  createdAt  DateTime @default(now())
  template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId, createdAt(sort: Desc)])
}

model FontFamily {
  id                    String      @id @default(uuid()) @db.Uuid
  family                String
  normalizedFamily      String      @unique
  displayName           String?
  source                String      @default("custom")
  sourceId              String?
  status                String      @default("ready")
  /// Pro-only font. Listed for everyone (the picker shows a crown); the paywall
  /// rises when it is APPLIED to a text layer. Toggling this MUST bump the font
  /// catalog version — the app caches the whole catalog until that number changes.
  isPremium             Boolean     @default(false)
  categories            Json
  previewText           String?
  previewWeight         Int?
  cssFontFamily         String?
  previewImageUrl       String?
  previewImageDarkUrl   String?
  previewImageUpdatedAt DateTime?
  sortOrder             Int         @default(0)
  removable             Boolean     @default(true)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  files                 FontFile[]
  aliases               FontAlias[]

  @@index([source])
  @@index([status])
  @@index([updatedAt])
  @@index([sortOrder])
}

model FontFile {
  id            String     @id @default(uuid()) @db.Uuid
  fontId        String     @db.Uuid
  /// Purpose + variant: "original"/"mobile" for the family's default face, suffixed for any
  /// other weight or style ("mobile@700", "mobile@400i"). Keeps @@unique([fontId, kind]) valid
  /// while letting one family hold every weight a design uses — Canva regularly ships 2-3.
  kind          String
  /// CSS weight this file IS (400/500/700…). Null = the default face, i.e. treat as 400.
  fontWeight    Int?
  /// "normal" | "italic". Null = normal.
  fontStyle     String?
  format        String
  mimeType      String
  fileName      String?
  storageBucket String?
  storagePath   String?
  publicUrl     String?
  sizeBytes     Int?
  checksum      String?
  status        String     @default("ready")
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  font          FontFamily @relation(fields: [fontId], references: [id], onDelete: Cascade)

  @@unique([fontId, kind])
  @@index([fontId])
  @@index([kind])
  @@index([status])
}

model FontAlias {
  id              String     @id @default(uuid()) @db.Uuid
  fontId          String     @db.Uuid
  alias           String
  normalizedAlias String     @unique
  createdAt       DateTime   @default(now())
  font            FontFamily @relation(fields: [fontId], references: [id], onDelete: Cascade)

  @@index([fontId])
}

model AppSetting {
  key       String   @id
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DashboardUser {
  id              String                 @id @default(uuid()) @db.Uuid
  name            String
  email           String
  normalizedEmail String                 @unique
  passwordHash    String
  role            String                 @default("designer")
  isSystemAdmin   Boolean                @default(false)
  bannedUntil     DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  invitesCreated  DashboardInviteToken[] @relation("DashboardInviteCreator")

  @@unique([email])
  @@index([role])
  @@index([createdAt])
}

model DashboardInviteToken {
  id              String         @id @default(uuid()) @db.Uuid
  email           String
  normalizedEmail String
  tokenHash       String         @unique
  role            String         @default("designer")
  expiresAt       DateTime
  consumedAt      DateTime?
  createdByUserId String?        @db.Uuid
  createdAt       DateTime       @default(now())
  createdByUser   DashboardUser? @relation("DashboardInviteCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([normalizedEmail])
  @@index([expiresAt])
}

model MobileUser {
  id              String                   @id @default(uuid()) @db.Uuid
  name            String?
  email           String?
  normalizedEmail String?
  emailVerified   Boolean                  @default(false)
  role            String                   @default("user")
  bannedUntil     DateTime?
  // Per-user monthly AI credit allowance. Null = use the global default from
  // mobile app settings; set a number to give this account its own balance.
  creditAllowance Int?
  // Denormalized entitlement written by the billing webhook/verify pipeline
  // (src/lib/billing). "free" | "plus" | "pro". Read-fast copy for the request path —
  // Subscription rows hold the full store state. A paid row past
  // subscriptionExpiresAt is treated as free (webhook retries can run out),
  // see resolveUserTier in src/lib/billing/subscriptionTier.server.ts.
  subscriptionTier      String    @default("free")
  subscriptionExpiresAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  identities      MobileIdentity[]
  refreshTokens   MobileRefreshToken[]
  deviceTokens    MobileDeviceToken[]
  favorites       MobileFavoriteTemplate[]
  contactMessages ContactMessage[]
  mediaUsage      MediaUsage[]
  subscriptions   Subscription[]

  @@index([normalizedEmail])
  @@index([createdAt])
  @@index([bannedUntil])
  @@index([role])
  @@index([subscriptionTier])
}

// One row per successful paid AI media run. Backs the monthly per-user credit
// wallet (src/lib/media/credits) and the spend breakdown per feature/model.
model MediaUsage {
  id           String     @id @default(uuid()) @db.Uuid
  mobileUserId String     @db.Uuid
  feature      String
  provider     String?
  model        String?
  // Credits deducted from the user's monthly wallet for this run.
  credits      Int        @default(0)
  // Provider cost in micro-dollars (1_000_000 = $1) — integer to avoid float drift.
  costMicros   Int        @default(0)
  // UTC "YYYY-MM" bucket the run counts against.
  periodKey    String     @db.VarChar(7)
  createdAt    DateTime   @default(now())
  mobileUser   MobileUser @relation(fields: [mobileUserId], references: [id], onDelete: Cascade)

  @@index([mobileUserId, feature, periodKey])
  @@index([periodKey])
  @@index([createdAt])
}

model MobileIdentity {
  id              String     @id @default(uuid()) @db.Uuid
  mobileUserId    String     @db.Uuid
  provider        String
  providerUserId  String
  email           String?
  normalizedEmail String?
  emailVerified   Boolean    @default(false)
  displayName     String?
  profile         Json?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  mobileUser      MobileUser @relation(fields: [mobileUserId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([mobileUserId])
  @@index([normalizedEmail])
}

model MobileRefreshToken {
  id           String     @id @default(uuid()) @db.Uuid
  mobileUserId String     @db.Uuid
  tokenHash    String     @unique
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  revokedAt    DateTime?
  lastUsedAt   DateTime?
  createdAt    DateTime   @default(now())
  mobileUser   MobileUser @relation(fields: [mobileUserId], references: [id], onDelete: Cascade)

  @@index([mobileUserId])
  @@index([expiresAt])
}

model MobileDeviceToken {
  id           String     @id @default(uuid()) @db.Uuid
  mobileUserId String     @db.Uuid
  token        String     @unique
  platform     String     @default("android")
  appVersion   String?
  disabledAt   DateTime?
  lastSeenAt   DateTime   @default(now())
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  mobileUser   MobileUser @relation(fields: [mobileUserId], references: [id], onDelete: Cascade)

  @@index([mobileUserId])
  @@index([disabledAt])
}

model MobileFavoriteTemplate {
  id           String     @id @default(uuid()) @db.Uuid
  mobileUserId String     @db.Uuid
  templateId   String     @db.Uuid
  createdAt    DateTime   @default(now())
  mobileUser   MobileUser @relation(fields: [mobileUserId], references: [id], onDelete: Cascade)
  template     Template   @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([mobileUserId, templateId])
  @@index([mobileUserId, createdAt(sort: Desc)])
  @@index([templateId])
}

model ContactMessage {
  id              String                @id @default(uuid()) @db.Uuid
  source          String                @default("web")
  name            String
  email           String
  topic           String                @default("general")
  device          String?
  message         String
  status          String                @default("new")
  mobileUserId    String?               @db.Uuid
  appVersion      String?
  userAgent       String?
  ipAddress       String?
  handledByUserId String?               @db.Uuid
  handledAt       DateTime?
  lastRepliedAt   DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  mobileUser      MobileUser?           @relation(fields: [mobileUserId], references: [id], onDelete: SetNull)
  replies         ContactMessageReply[]

  @@index([createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([source])
  @@index([topic])
  @@index([mobileUserId])
}

// One outbound email per row: the support thread hanging off a ContactMessage.
// Rows are kept even when delivery fails so the drawer can show what was
// attempted and why it bounced, rather than silently losing the draft.
//
// "messageId"/"inReplyTo" are the RFC 5322 headers we stamp on the outgoing
// mail. Threading them is what makes the customer's mail client stack our
// replies into one conversation instead of N unrelated emails.
model ContactMessageReply {
  id               String   @id @default(uuid()) @db.Uuid
  contactMessageId String   @db.Uuid
  body             String
  subject          String
  fromEmail        String
  toEmail          String
  authorUserId     String?  @db.Uuid
  authorName       String
  messageId        String?
  inReplyTo        String?
  status           String   @default("sent")
  error            String?
  createdAt        DateTime @default(now())

  contactMessage ContactMessage @relation(fields: [contactMessageId], references: [id], onDelete: Cascade)

  @@index([contactMessageId, createdAt])
  @@index([status])
}

// The AI Tools catalog: admin-authored prompt templates the mobile app will list
// and run by slug (the Andalusi toolSlug contract). The prompt column is the
// product asset — it is served only through the dashboard admin API and the
// server-side run route, never through any mobile-facing catalog endpoint.
model AiTemplateCategory {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique
  titleEn   String
  titleAr   String
  sortOrder Int      @default(0)
  published Boolean  @default(true)
  isNew     Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  templates AiTemplate[]

  @@index([sortOrder])
}

model AiTemplate {
  id            String   @id @default(uuid()) @db.Uuid
  slug          String   @unique
  categoryId    String   @db.Uuid
  titleEn       String
  titleAr       String
  /// Server-side edit instruction sent to the model. Never expose to clients.
  prompt        String
  model         String   @default("google/nano-banana")
  /// Which reference input the template expects (portrait, product, food, …) —
  /// drives the sample art pipeline and the picker hint in the app.
  referenceKind String   @default("portrait")
  beforeUrl     String?
  afterUrl      String?
  /// Grid-sized copy of afterUrl (400px). The full-size card art is ~140 KB
  /// each, which is a 30 MB tab; the app lists thumbs and loads afterUrl only
  /// when a tool is opened.
  thumbUrl      String?
  creditCost    Int      @default(100)
  isPremium     Boolean  @default(false)
  published     Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  category AiTemplateCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId, sortOrder])
  @@index([published, categoryId])
}

// Internal image library for the dashboard: uploaded once, reused anywhere an
// admin needs a picture (first consumer: "before" inputs on AI templates).
// storageKey is kept so deleting a row can also delete the R2 object.
model GalleryImage {
  id              String   @id @default(uuid()) @db.Uuid
  name            String   @default("")
  url             String
  storageKey      String
  width           Int?
  height          Int?
  sizeBytes       Int?
  mimeType        String?
  createdByUserId String?  @db.Uuid
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([createdAt(sort: Desc)])
}

model PushCampaign {
  id           String   @id @default(uuid()) @db.Uuid
  title        String
  body         String
  audienceType String
  audienceRef  Json
  messageType  String   @default("notification")
  payload      Json
  targetCount  Int      @default(0)
  successCount Int      @default(0)
  failureCount Int      @default(0)
  status       String   @default("sent")
  error        String?
  sentByUserId String   @db.Uuid
  createdAt    DateTime @default(now())

  @@index([createdAt(sort: Desc)])
}

// ---------------------------------------------------------------------------
// Raw-SQL infrastructure tables, adopted into the schema 2026-08-12.
//
// These three tables are created and queried exclusively through hand-written
// SQL ($queryRaw stores in src/lib/tools/importJobsStore.server.js and
// src/lib/editor/imported{Backgrounds,Elements}.server.js), which also
// CREATE TABLE IF NOT EXISTS them at runtime. They are declared here with
// @@ignore so `prisma migrate` knows they are wanted — without these blocks a
// generated migration tries to DROP them — while @@ignore keeps them out of
// the generated Prisma Client, so the raw-SQL stores remain the only API.
// Shapes mirror the migrations exactly (introspected from a clean replay).
// ---------------------------------------------------------------------------

model editor_background_assets {
  id                 String    @id @db.Uuid
  source             String
  source_asset_id    String
  owner_id           String?   @db.Uuid
  kind               String    @default("image")
  title_en           String
  title_ar           String
  tags_en            Json      @default("[]")
  tags_ar            Json      @default("[]")
  labels_en          Json      @default("[]")
  labels_ar          Json      @default("[]")
  slug               String?
  author_id          Int?
  author_name        String?
  category_value     String?
  asset_url          String
  thumbnail_url      String
  width              Int?
  height             Int?
  source_payload     Json      @default("{}")
  translation_status String    @default("fallback")
  /// Pro-only background (see FontFamily.isPremium for the same concept).
  is_premium         Boolean   @default(false)
  created_source_at  DateTime? @db.Timestamptz(6)
  created_at         DateTime  @default(now()) @db.Timestamptz(6)
  updated_at         DateTime  @default(now()) @db.Timestamptz(6)

  @@unique([source, source_asset_id], map: "editor_background_assets_source_asset_unique")
  @@index([category_value, updated_at(sort: Desc)], map: "editor_background_assets_category_updated_idx")
  @@index([source, updated_at(sort: Desc)], map: "editor_background_assets_source_updated_idx")
  @@ignore
}

model editor_element_assets {
  id                 String    @id @db.Uuid
  source             String
  source_asset_id    String
  owner_id           String?   @db.Uuid
  kind               String    @default("icon")
  title_en           String
  title_ar           String
  tags_en            Json      @default("[]")
  tags_ar            Json      @default("[]")
  labels_en          Json      @default("[]")
  labels_ar          Json      @default("[]")
  slug               String?
  style_id           Int?
  style_name         String?
  family_id          Int?
  family_name        String?
  author_id          Int?
  author_name        String?
  asset_url          String
  thumbnail_url      String
  width              Int?
  height             Int?
  free_svg           Boolean   @default(false)
  /// Pro-only element (see FontFamily.isPremium for the same concept).
  is_premium         Boolean   @default(false)
  source_payload     Json      @default("{}")
  translation_status String    @default("fallback")
  created_source_at  DateTime? @db.Timestamptz(6)
  created_at         DateTime  @default(now()) @db.Timestamptz(6)
  updated_at         DateTime  @default(now()) @db.Timestamptz(6)

  @@unique([source, source_asset_id], map: "editor_element_assets_source_asset_unique")
  @@index([source, kind, updated_at(sort: Desc)], map: "editor_element_assets_source_kind_updated_idx")
  @@index([tags_ar], map: "editor_element_assets_tags_ar_gin_idx", type: Gin)
  @@index([tags_en], map: "editor_element_assets_tags_en_gin_idx", type: Gin)
  @@ignore
}

model import_jobs {
  id                   String    @id @db.Uuid
  owner_id             String    @db.Uuid
  type                 String
  status               String    @default("pending")
  idempotency_key      String?
  input                Json      @default("{}")
  result               Json?
  error                String?
  progress             String    @default("")
  attempts             Int       @default(0)
  started_at           DateTime? @db.Timestamptz(6)
  finished_at          DateTime? @db.Timestamptz(6)
  created_at           DateTime  @default(now()) @db.Timestamptz(6)
  updated_at           DateTime  @default(now()) @db.Timestamptz(6)
  locked_at            DateTime? @db.Timestamptz(6)
  locked_by            String?
  produced_template_id String?   @db.Uuid

  @@unique([owner_id, type, idempotency_key], map: "import_jobs_owner_type_idempotency_key_idx")
  @@index([owner_id, created_at(sort: Desc)], map: "import_jobs_owner_idx")
  @@index([status, created_at(sort: Desc)], map: "import_jobs_status_idx")
  @@ignore
}

/// One-tap "Magic Tools" — image in, image out, no prompt from the user.
/// Deliberately NOT an AiTemplate: these carry no category, several run on
/// prompt-less specialist models (upscalers, face restorers, the self-hosted
/// background remover), and each tool tunes its model through modelOptions
/// rather than through wording.
model MagicTool {
  id            String   @id @default(uuid()) @db.Uuid
  slug          String   @unique
  titleEn       String
  titleAr       String
  /// Short Arabic line shown under the tool name in the app.
  subtitleAr    String   @default("")
  /// Server-side instruction for prompt-driven models; empty for the
  /// specialist models that take an image and nothing else. Admin-only.
  prompt        String   @default("")
  model         String   @default("google/nano-banana")
  /// Per-tool model knobs (upscale factor, colorizer variant, …) merged over
  /// the registry defaults. Lets two tools share one model and behave apart.
  modelOptions  Json?
  beforeUrl     String?
  afterUrl      String?
  /// Grid-sized copy of afterUrl (400px) — see AiTemplate.thumbUrl.
  thumbUrl      String?
  creditCost    Int      @default(100)
  isPremium     Boolean  @default(false)
  published     Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([published, sortOrder])
}

/// A material style applied to a TEXT layer (gold, diamond, glitter, …) —
/// Andalusi's "Effects" strip. Deliberately NOT a generated image: `spec`
/// describes the fill declaratively so the web editor (Konva/canvas) and the
/// mobile app (Compose) can each draw it natively. That keeps it free,
/// instant, and — the whole point — the text stays editable afterwards.
model TextEffect {
  id         String   @id @default(uuid()) @db.Uuid
  slug       String   @unique
  titleEn    String
  titleAr    String
  /// Declarative fill/stroke/shadow description. See src/lib/textEffects/spec.js
  /// — both platforms render from this, so changing its shape is a contract
  /// change, not a local edit.
  spec       Json
  /// Sample rendering shown in the effects strip. Generated from `spec`, so it
  /// can always be rebuilt and never drifts from what the effect actually does.
  previewUrl String?
  isPremium  Boolean  @default(false)
  published  Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([published, sortOrder])
}

// One row per store subscription (Nayroz Pro). Written only by the billing
// pipeline (src/lib/billing): the mobile /subscriptions/verify endpoint and the
// App Store / Play webhooks, both of which re-check state with the store before
// touching this table. MobileUser.subscriptionTier/subscriptionExpiresAt are the
// denormalized read-fast copy of the latest active row.
model Subscription {
  id           String     @id @default(uuid()) @db.Uuid
  mobileUserId String     @db.Uuid
  mobileUser   MobileUser @relation(fields: [mobileUserId], references: [id], onDelete: Cascade)
  /// "apple" | "google"
  platform     String
  /// Store product: App Store product id (nayroz_plus_monthly) or Play
  /// "subscriptionId:basePlanId" (nayroz_plus:monthly).
  productId    String
  /// "monthly" | "yearly" — parsed from productId so the app/admin never has to.
  planKey      String
  /// The store's stable identity for the subscription: Apple
  /// originalTransactionId, Google the LATEST purchaseToken. This is the
  /// idempotency key and the guard against one receipt unlocking two accounts.
  storeKey     String     @unique
  /// Google resubscribe/upgrade issues a fresh token that voids the previous
  /// one (carried here) — applyStoreState expires the row it points at.
  linkedPurchaseToken String?
  /// "active" | "trialing" | "cancelled" (auto-renew off, entitled until
  /// expiry) | "grace" | "hold" | "paused" | "expired" | "revoked"
  status       String
  /// "trial" | "normal"
  periodType   String     @default("normal")
  currentPeriodEnd DateTime?
  autoRenewing Boolean    @default(true)
  /// "production" | "sandbox" | "xcode-test" — sandbox rows never flip the
  /// user tier unless ALLOW_SANDBOX_ENTITLEMENTS is set.
  environment  String     @default("production")
  lastNotificationType String?
  lastNotificationAt   DateTime?
  /// Latest raw store state (SubscriptionPurchaseV2 / decoded transaction) for
  /// debugging; never read by application logic.
  raw          Json?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([mobileUserId])
  @@index([status, currentPeriodEnd])
}

// Dedupe + audit ledger for store server notifications (App Store Server
// Notifications V2, Play RTDN). The webhook inserts first (unique id = the
// store's own notification id, so retries collapse), processes inline, then
// stamps the outcome. Failed rows stay queryable for manual replay — Apple
// retries a few times and Pub/Sub retries on 5xx, but neither retries forever.
model StoreNotification {
  /// Apple notificationUUID / Pub/Sub messageId.
  id          String    @id
  /// "apple" | "google"
  platform    String
  /// Store notification type (e.g. DID_RENEW, SUBSCRIPTION_PURCHASED).
  type        String
  /// Decoded notification body (NOT the raw JWS — that never needs replaying).
  payload     Json
  /// "processing" (in flight) | "processed" | "failed" | "skipped"
  status      String
  error       String?
  attempts    Int       @default(1)
  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  @@index([platform, status, receivedAt])
}

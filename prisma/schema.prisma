// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Template {
  id                String             @id @default(uuid()) @db.Uuid
  ownerId           String             @db.Uuid
  name              String
  slug              String             @unique
  status            String             @default("draft")
  version           Int                @default(1)
  canvasSize        Json
  category          String             @default("general")
  subCategory       String             @default("general")
  tags              Json
  thumbnailDataUrl  String?
  previewVideoUrl   String?
  previewPosterUrl  String?
  previewStatus     String?
  previewDurationMs Int?
  previewVersion    Int?
  previewError      String?
  previewUpdatedAt  DateTime?
  data              Json
  publishedAt       DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  revisions         TemplateRevision[]
  favorites         MobileFavoriteTemplate[]

  @@unique([ownerId, name])
  @@index([ownerId])
  @@index([status])
}

model TemplateRevision {
  id         String   @id @default(uuid()) @db.Uuid
  templateId String   @db.Uuid
  version    Int
  action     String
  actorId    String   @db.Uuid
  snapshot   Json
  createdAt  DateTime @default(now())
  template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId, createdAt(sort: Desc)])
}

model FontFamily {
  id               String      @id @default(uuid()) @db.Uuid
  family           String
  normalizedFamily String      @unique
  displayName      String?
  source           String      @default("custom")
  sourceId         String?
  status           String      @default("ready")
  categories       Json
  previewText      String?
  previewWeight    Int?
  cssFontFamily    String?
  previewImageUrl       String?
  previewImageDarkUrl   String?
  previewImageUpdatedAt DateTime?
  removable        Boolean     @default(true)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  files            FontFile[]
  aliases          FontAlias[]

  @@index([source])
  @@index([status])
  @@index([updatedAt])
}

model FontFile {
  id            String     @id @default(uuid()) @db.Uuid
  fontId        String     @db.Uuid
  kind          String
  format        String
  mimeType      String
  fileName      String?
  storageBucket String?
  storagePath   String?
  publicUrl     String?
  sizeBytes     Int?
  checksum      String?
  status        String     @default("ready")
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  font          FontFamily @relation(fields: [fontId], references: [id], onDelete: Cascade)

  @@unique([fontId, kind])
  @@index([fontId])
  @@index([kind])
  @@index([status])
}

model FontAlias {
  id              String     @id @default(uuid()) @db.Uuid
  fontId          String     @db.Uuid
  alias           String
  normalizedAlias String     @unique
  createdAt       DateTime   @default(now())
  font            FontFamily @relation(fields: [fontId], references: [id], onDelete: Cascade)

  @@index([fontId])
}

model AppSetting {
  key       String   @id
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DashboardUser {
  id              String                 @id @default(uuid()) @db.Uuid
  name            String
  email           String
  normalizedEmail String                 @unique
  passwordHash    String
  role            String                 @default("designer")
  isSystemAdmin   Boolean                @default(false)
  bannedUntil     DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  invitesCreated  DashboardInviteToken[] @relation("DashboardInviteCreator")

  @@unique([email])
  @@index([role])
  @@index([createdAt])
}

model DashboardInviteToken {
  id              String         @id @default(uuid()) @db.Uuid
  email           String
  normalizedEmail String
  tokenHash       String         @unique
  role            String         @default("designer")
  expiresAt       DateTime
  consumedAt      DateTime?
  createdByUserId String?        @db.Uuid
  createdAt       DateTime       @default(now())
  createdByUser   DashboardUser? @relation("DashboardInviteCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([normalizedEmail])
  @@index([expiresAt])
}

model MobileUser {
  id              String               @id @default(uuid()) @db.Uuid
  name            String?
  email           String?
  normalizedEmail String?
  emailVerified   Boolean              @default(false)
  lastLoginAt     DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  identities      MobileIdentity[]
  refreshTokens   MobileRefreshToken[]
  deviceTokens    MobileDeviceToken[]
  favorites       MobileFavoriteTemplate[]

  @@index([normalizedEmail])
  @@index([createdAt])
}

model MobileIdentity {
  id              String     @id @default(uuid()) @db.Uuid
  mobileUserId    String     @db.Uuid
  provider        String
  providerUserId  String
  email           String?
  normalizedEmail String?
  emailVerified   Boolean    @default(false)
  displayName     String?
  profile         Json?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  mobileUser      MobileUser @relation(fields: [mobileUserId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([mobileUserId])
  @@index([normalizedEmail])
}

model MobileRefreshToken {
  id           String     @id @default(uuid()) @db.Uuid
  mobileUserId String     @db.Uuid
  tokenHash    String     @unique
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  revokedAt    DateTime?
  lastUsedAt   DateTime?
  createdAt    DateTime   @default(now())
  mobileUser   MobileUser @relation(fields: [mobileUserId], references: [id], onDelete: Cascade)

  @@index([mobileUserId])
  @@index([expiresAt])
}

model MobileDeviceToken {
  id           String     @id @default(uuid()) @db.Uuid
  mobileUserId String     @db.Uuid
  token        String     @unique
  platform     String     @default("android")
  appVersion   String?
  disabledAt   DateTime?
  lastSeenAt   DateTime   @default(now())
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  mobileUser   MobileUser @relation(fields: [mobileUserId], references: [id], onDelete: Cascade)

  @@index([mobileUserId])
  @@index([disabledAt])
}

model MobileFavoriteTemplate {
  id           String     @id @default(uuid()) @db.Uuid
  mobileUserId String     @db.Uuid
  templateId   String     @db.Uuid
  createdAt    DateTime   @default(now())
  mobileUser   MobileUser @relation(fields: [mobileUserId], references: [id], onDelete: Cascade)
  template     Template   @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([mobileUserId, templateId])
  @@index([mobileUserId, createdAt(sort: Desc)])
  @@index([templateId])
}

model PushCampaign {
  id           String   @id @default(uuid()) @db.Uuid
  title        String
  body         String
  audienceType String
  audienceRef  Json
  messageType  String   @default("notification")
  payload      Json
  targetCount  Int      @default(0)
  successCount Int      @default(0)
  failureCount Int      @default(0)
  status       String   @default("sent")
  error        String?
  sentByUserId String   @db.Uuid
  createdAt    DateTime @default(now())

  @@index([createdAt(sort: Desc)])
}
